<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="AgentPack.exe"
        Arguments=""
        InstallLocation="C:\Program Files\sugu6\AgentPack">
    </Installer>
    <PackageInformation
        PackageName="AgentPack"
        PackageDisplayName="AgentPack"
        PublisherName="CN=sugu6"
        PublisherDisplayName="sugu6"
        Version="0.2.3.0"
        PackageDescription="AgentPack - Unified management of MCP / Skills / Agent configurations">
        <Capabilities>
            <Capability Name="runFullTrust" />
        </Capabilities>
        <Applications>
            <Application
                Id="com.sugu6.agentpack"
                Description="AgentPack - Unified management of MCP / Skills / Agent configurations"
                DisplayName="AgentPack"
                ExecutableName="AgentPack.exe"
                EntryPoint="Windows.FullTrustApplication">
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AgentPack</DisplayName>
            <PublisherDisplayName>sugu6</PublisherDisplayName>
            <Description>AgentPack - Unified management of MCP / Skills / Agent configurations</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="AgentPack.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
